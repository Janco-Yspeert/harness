{
  "name": "harness",
  "version": "0.0.0",
  "private": true,
  "description": "An Ubuntu-hosted control plane for supervising AI coding agents.",
  "author": "Janco Yspeert",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  }
}
