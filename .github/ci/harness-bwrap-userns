# This profile exists only for the ephemeral GitHub Actions runner. Ubuntu 24.04
# otherwise blocks unprivileged user namespaces globally. Bubblewrap needs a
# user namespace and CAP_SYS_ADMIN within that namespace to construct the
# mount/PID sandbox; the package's stacked bwrap profile denies that capability.
#
# The profile is deliberately attached only to the Bubblewrap executable. It
# neither changes AppArmor's global user-namespace policy nor grants user
# namespaces to the test process or arbitrary executables.
abi <abi/4.0>,
include <tunables/global>

profile harness-bwrap-userns /usr/bin/bwrap flags=(unconfined) {
  userns,
}
