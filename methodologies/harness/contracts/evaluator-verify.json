{
  "schemaVersion": 1,
  "workspaces": ["repository", "evaluation"],
  "capabilities": [
    "repository-read",
    "repository-write",
    "local-computation",
    "git-inspect",
    "git-commit"
  ],
  "forbiddenExposure": [],
  "protected": true,
  "inputs": [
    {
      "name": "brief",
      "event": "brief-frozen",
      "committed": true
    },
    {
      "name": "design",
      "event": "design-map-frozen",
      "committed": true
    },
    {
      "name": "coverage",
      "event": ["evaluation-prepared", "evaluator-repair-recorded"],
      "committed": true,
      "validator": "prepared-coverage"
    },
    {
      "name": "candidate",
      "event": "implementation-handoff",
      "field": "commit"
    },
    {
      "name": "evaluatorRevision",
      "path": "coverage-map.json",
      "jsonValue": "readiness.evaluatorRevision"
    }
  ],
  "results": ["succeeded", "blocked", "refused", "failed"],
  "methodology": {
    "result": ["PASS", "FAIL", "BLOCKED"],
    "classification": [
      "IMPLEMENTATION_FAILURE",
      "EVALUATOR_DEFECT",
      "SPECIFICATION_AMBIGUITY",
      "SPECIFICATION_DRIFT",
      "INFRASTRUCTURE_FAILURE"
    ]
  },
  "resultConstraints": [
    { "when": { "result": "PASS" }, "absent": ["classification"] },
    { "when": { "result": "FAIL" }, "required": ["classification"] },
    { "when": { "result": "BLOCKED" }, "required": ["classification"] }
  ],
  "human": ["input", "approval", "root"],
  "postconditions": ["verification-result.json", "manifest.md"],
  "promotion": {
    "sourceWorkspace": "evaluation",
    "destinationWorkspace": "repository",
    "destination": "evaluation",
    "candidateInput": "candidate",
    "revisionInput": "evaluatorRevision",
    "when": { "result": "PASS" },
    "allocationEvent": "verification-allocated",
    "attemptField": "attempt",
    "transition": "promotion-recorded"
  }
}
